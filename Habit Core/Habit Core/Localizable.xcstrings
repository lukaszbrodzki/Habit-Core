    "settings.stats.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grids and statistics include only each habit’s most recent occurrences — days, weeks or months, depending on its frequency. Older history is kept, just not counted. A period still in progress counts once it’s done."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siatki i statystyki obejmują tylko ostatnie wystąpienia każdego nawyku — dni, tygodnie lub miesiące, zależnie od częstotliwości. Starsza historia zostaje zachowana, tylko nie jest liczona. Trwający okres liczy się, gdy zostanie wykonany."
          }
        }
      }
    }
